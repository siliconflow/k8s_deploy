# k8s_deploy.sh 配置文件
# 修改部署参数只改这个文件，脚本会读取这里的配置。

# 节点角色与 IP 清单；第一列角色，第二列 IP；多角色可写 master/worker 或 master,worker。
ROLE_IP_LIST_FILE="/data/k8s-deploy_kylinv10/role_and_ip_list.txt"
# 节点上的离线物料目录；脚本会把本地离线物料分发到该目录。
REMOTE_DIR="/data/k8s_data"
# 本地离线物料目录；如果本地不存在，脚本会退回使用 REMOTE_DIR。
OFFLINE_DIR="/data/k8s-deploy_kylinv10/offline-assets/offline"

# SSH 登录用户；部署机会用该用户连接所有节点。
SSH_USER="root"
# SSH 私钥路径；要求部署机到所有节点已配置 root SSH 免密登录。
SSH_KEY="/root/.ssh/id_rsa_vm_deploy"

# Kubernetes 版本；必须与 download.sh 下载的 kubeadm/kubelet/kubectl 和镜像版本一致。
K8S_VERSION="v1.28.15"
# kubeadm 默认镜像仓库；启用私有 registry 后会自动改成 PRIVATE_REGISTRY/K8S_IMAGE_REPO。
K8S_IMAGE_REPO="registry.aliyuncs.com/google_containers"
# Pod 网段；需要与 Calico/flannel 清单中的网段一致。
POD_CIDR="10.244.0.0/16"
# Service 网段；一般保持 Kubernetes 默认即可。
SERVICE_CIDR="10.96.0.0/12"
# CNI 网络插件；可选 calico 或 flannel。
CNI_PLUGIN="calico"
# 离线物料强校验；1 表示离线物料不完整时直接报错退出，0 表示自动降级为在线安装。
REQUIRE_OFFLINE="1"
# Kubernetes 控制面入口；留空时自动按 SLB_ENDPOINT、首个 master IP 顺序生成。
CONTROL_PLANE_ENDPOINT=""

# 集群CA保存目录；首次部署生成100年CA后长期复用（reset/uninstall 不删除），删除该目录可重建CA。
#CLUSTER_CA_DIR="/data/k8s-deploy_kylinv10/k8s-cluster-pki"
# 集群证书有效期（天）；默认 36500 即100年，每次执行 deploy 都会重签控制面证书。
#CERT_VALID_DAYS=36500

# 私有镜像仓库地址；镜像默认通过各节点本地导入，无需私有仓库。
# 仅在需要独立镜像仓库时填写，例如 192.168.122.30:5000；留空表示不启用。
PRIVATE_REGISTRY="192.168.122.38"
# 私有镜像仓库端口；PRIVATE_REGISTRY 留空时会拼成 第一个 master IP:port。
REGISTRY_PORT="5000"
# registry 服务镜像；download.sh 已离线下载该镜像。
REGISTRY_IMAGE="registry:2"

# 外部 SLB 入口；使用外部负载均衡（如 F5）时填写，例如 192.168.122.100:6443。
# SLB 后端需转发到所有 master 的 6443；证书 SAN 会自动包含该地址。
# apiserver 后端端口默认 6443（APISERVER_PORT），一般无需修改。
SLB_ENDPOINT="192.168.122.100:6443"
